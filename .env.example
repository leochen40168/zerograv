# ============================================================
# ZeroGrav 環境設定範本
# 複製此檔為 .env 並填入實際設定值
# 警告：.env 絕對不可上傳 git！
# ============================================================

# 應用程式
APP_NAME="ZeroGrav 二手儀器交易平台"
APP_URL=https://zerograv.com.tw
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Taipei

# 資料庫
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cycleflo_zerograv
DB_USER=cycleflo_zerograv
DB_PASS=your_password_here
DB_CHARSET=utf8mb4

# Session
SESSION_NAME=zerograv_sess
SESSION_LIFETIME=7200

# 圖片上傳
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=public/uploads/listings

# 管理員信箱（系統通知用）
ADMIN_EMAIL=admin@zerograv.com.tw

# 安全
CSRF_SECRET=change_this_to_random_32_chars_string
